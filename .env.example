# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，不会提交。
# 环境变量的优先级高于本文件。

# 必填：DeepSeek API Key（https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=

# 选填：接口地址。官方地址为 https://api.deepseek.com，
# 也兼容任何 OpenAI 兼容网关（会自动补 /v1）。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 选填：模型名。deepseek-chat 速度快，deepseek-reasoner 推理更强但更慢。
DEEPSEEK_MODEL=deepseek-chat

# 选填：生成参数
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_TIMEOUT=180
DEEPSEEK_MAX_RETRIES=3

# 选填：产物根目录（相对项目根目录或绝对路径），默认 runs
WORKFLOW_RUNS_DIR=runs

# 选填：设为 1 则强制离线演示模式
WORKFLOW_MOCK=0
